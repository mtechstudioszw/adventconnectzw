# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/
**/.gradle/

# Claude Code working directory (local agent state, not project source)
.claude/

# Release signing material — keystores and the props file that points
# at them, including the AdMob app id. android/key.properties.example
# is checked in as the template.
android/key.properties
*.jks
*.keystore
ios/Flutter/AdMob.xcconfig

# Loose screenshots and diagnostic captures dropped into the repo root
Screenshot*.png
Screenshot*.jpg
Screenshot*.jpeg

# npm install --no-save for scripts/broadcast-email.js leaves this behind
node_modules/

# Broadcast send log — who has already received the current campaign.
scripts/.broadcast-sent.log
scripts/*.tmp.*
