# Copy to .env.local before running `npm run dev`.
# .env.local is gitignored — never commit real keys.

# === Supabase ===
# Found in Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# The service role key bypasses RLS — it MUST stay server-side and is
# never sent to the browser. It's only read inside server actions and
# route handlers via lib/supabase/server.ts.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# === Auth allowlist ===
# Comma-separated emails that are allowed to sign in to this admin
# panel. Anyone outside this list is rejected even if they have a
# Supabase account. Keep this list tiny — it's the keys to the
# kingdom.
ADMIN_EMAILS=tanatswamichaelmikuwa@gmail.com

# === Transactional notifications (optional) ===
# Used by lib/notify/email.ts + lib/notify/whatsapp.ts to send the
# approve / reject email + WhatsApp on top of the in-app notification.
# Leave blank to skip — the admin flow keeps working either way.
#
# Resend (https://resend.com) — verify your sending domain first.
RESEND_API_KEY=
NOTIFY_FROM=Advent Connect ZW <hello@adventconnect.zw>
#
# Meta WhatsApp Cloud API — from developers.facebook.com/apps.
# Phone number ID lives in WhatsApp Manager → Phone numbers.
# Token should be a long-lived System User token, not a 24-hour one.
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
