# Copy to .env.local for local development, and set the same two values in
# the Vercel project settings.
#
# Both are PUBLIC by design and are the same pair already shipped inside the
# Flutter app. They grant nothing on their own: every admin RPC is
# SECURITY DEFINER and re-checks the caller's staff role in the database.
#
# There is deliberately NO service-role key here. If you ever find yourself
# adding one, stop — it bypasses RLS entirely and nothing in this console
# needs it.

NEXT_PUBLIC_SUPABASE_URL=https://eqbyvasteolqyktbqbem.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
