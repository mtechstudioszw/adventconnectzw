<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Voice notes: chat audio recording (record package). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Required for playing voice notes streamed from Supabase storage. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Network state for connectivity_plus offline detection. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Geolocator: nearest churches sort + distance chips. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- local_auth: biometric quick unlock in Settings. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <!-- Android 13+ runtime notification prompt — without this declared,
         FCM pushes silently never arrive on devices ≥ API 33. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- just_audio_background: foreground media-playback service so Library
         music keeps playing when the app is backgrounded and shows a media
         notification with play/pause/next controls. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- image_picker (camera path) + profile/cover photo capture flows.
         Without this declared, Permission.camera.request() returns
         "granted" immediately on Android without ever showing the
         native dialog — which looks like a broken button to the user. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- NOTE: no READ_MEDIA_IMAGES / READ_EXTERNAL_STORAGE. Photo picking
         goes through the Android Photo Picker (image_picker 1.x on API
         33+) / ACTION_GET_CONTENT, which need no permission, and saving
         received images uses gal's add-only access. This keeps the app
         compliant with Google Play's Photo & Video Permissions policy
         (no broad-access declaration required). -->
    <application
        android:label="Advent Connect ZW"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Deep link for Supabase password-recovery emails. The
                 reset link sent by Supabase uses redirectTo set in
                 AuthService.sendPasswordReset; the auth state listener
                 in main.dart routes to /reset-password on the
                 passwordRecovery event. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="io.supabase.adventconnect"
                      android:host="login-callback"/>
            </intent-filter>
            <!-- Shared-content deep links. The *-share Supabase Edge
                 Functions render a web page that bounces to one of these
                 io.supabase.adventconnect:// URLs (and falls back to the
                 Play Store if nothing handles them). DeepLinkService
                 catches the incoming Uri and routes to the matching
                 details screen. Custom scheme => autoVerify not needed;
                 one host per shareable type keeps them distinct from the
                 login-callback above. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="io.supabase.adventconnect" android:host="event"/>
                <data android:scheme="io.supabase.adventconnect" android:host="product"/>
                <data android:scheme="io.supabase.adventconnect" android:host="job"/>
                <data android:scheme="io.supabase.adventconnect" android:host="seller"/>
            </intent-filter>
        </activity>
        <!-- image_cropper (UCrop) — registers the native crop activity
             so picking + cropping a profile / cover photo doesn't crash
             with ActivityNotFoundException. Theme must be AppCompat-
             based since UCrop is built on it. -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"/>
        <!-- FCM default channel — used if a push arrives before the
             Flutter side has called createNotificationChannel(). Must
             match the channel id created in PushService.initialize. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="advent_connect_zw_default" />
        <!-- Monochrome notification icon for the status bar. Falls back
             to the launcher icon if missing. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />
        <!-- AdMob application ID (Advent Connect ZW, Android). The matching
             ad-unit IDs live in lib/services/ads/ad_config.dart — paste the
             real banner/native/app-open/interstitial unit IDs there to start
             earning (until then AdConfig serves Google test units). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-9393348961586729~4087273606" />
        <!-- just_audio_background: the media-session service + media-button
             receiver that power background playback and the lock-screen /
             notification controls for the Library Music player. -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService"/>
            </intent-filter>
        </service>
        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON"/>
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Android 11+ package visibility: without these, url_launcher's
             canLaunchUrl() returns false for these schemes even when a
             handler app exists. Needed for Maps directions (https),
             phone dialer (tel), email (mailto), and SMS. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="mailto"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="smsto"/>
        </intent>
    </queries>
</manifest>
