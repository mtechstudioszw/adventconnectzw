<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Voice notes: chat audio recording (record package). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Required for playing voice notes streamed from Supabase storage. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Network state for connectivity_plus offline detection. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Geolocator: nearest churches sort + distance chips.

         COARSE ONLY, deliberately. LocationService asks for
         `LocationAccuracy.medium` (roughly 100-500m) and nothing in the app
         asks for better — the feature is "sort churches by how near they
         are", which a city block of precision answers perfectly well.

         ACCESS_FINE_LOCATION was declared anyway. It bought nothing, and it
         cost: precise location is one of the permissions Play reviews
         hardest, it carries a heavier Data Safety declaration, and Android
         shows the member a Precise/Approximate choice they should not have
         to think about for a church finder.

         The tools:node="remove" is load-bearing. The geolocator plugin
         merges ACCESS_FINE_LOCATION in from its own manifest, so simply
         deleting our line would leave the permission in the built APK and
         change nothing. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        tools:node="remove"/>
    <!-- local_auth: biometric quick unlock in Settings. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <!-- Android 13+ runtime notification prompt — without this declared,
         FCM pushes silently never arrive on devices ≥ API 33. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- just_audio_background: foreground media-playback service so Library
         music keeps playing when the app is backgrounded and shows a media
         notification with play/pause/next controls. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- image_picker (camera path) + profile/cover photo capture flows.
         Without this declared, Permission.camera.request() returns
         "granted" immediately on Android without ever showing the
         native dialog — which looks like a broken button to the user. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- NOTE: no READ_MEDIA_IMAGES / READ_EXTERNAL_STORAGE. Photo picking
         goes through the Android Photo Picker (image_picker 1.x on API
         33+) / ACTION_GET_CONTENT, which need no permission, and saving
         received images uses gal's add-only access. This keeps the app
         compliant with Google Play's Photo & Video Permissions policy
         (no broad-access declaration required). -->
    <!-- tools:replace="android:allowBackup" is what makes this build at all.
         Appodeal's core SDK (com.appodeal.ads.sdk:core) declares
         android:allowBackup="true" in its own manifest, and the merger
         refuses to pick between two explicit values — so every build since
         the AdMob → Appodeal migration failed at :app:processDebugMainManifest
         with "Attribute application@allowBackup value=(false) ... is also
         present at [com.appodeal.ads.sdk:core]".

         The value stays FALSE. Android's auto-backup would copy app data off
         the device to the member's Google Drive; this app holds auth state
         and cached personal content (chats, prayer requests), and the Play
         data-safety declaration says it is not backed up. Flipping it to
         true would clear the merger and quietly change what leaves the
         phone — the SDK's default is not a reason to change our posture. -->
    <application
        android:label="Advent Connect ZW"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        tools:replace="android:allowBackup">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Deep link for Supabase password-recovery emails. The
                 reset link sent by Supabase uses redirectTo set in
                 AuthService.sendPasswordReset; the auth state listener
                 in main.dart routes to /reset-password on the
                 passwordRecovery event. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="io.supabase.adventconnect"
                      android:host="login-callback"/>
            </intent-filter>
            <!-- Shared-content deep links. The *-share Supabase Edge
                 Functions render a web page that bounces to one of these
                 io.supabase.adventconnect:// URLs (and falls back to the
                 Play Store if nothing handles them). DeepLinkService
                 catches the incoming Uri and routes to the matching
                 details screen. Custom scheme => autoVerify not needed;
                 one host per shareable type keeps them distinct from the
                 login-callback above. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="io.supabase.adventconnect" android:host="event"/>
                <data android:scheme="io.supabase.adventconnect" android:host="product"/>
                <data android:scheme="io.supabase.adventconnect" android:host="job"/>
                <data android:scheme="io.supabase.adventconnect" android:host="seller"/>
            </intent-filter>
        </activity>
        <!-- image_cropper (UCrop) — registers the native crop activity
             so picking + cropping a profile / cover photo doesn't crash
             with ActivityNotFoundException. Theme must be AppCompat-
             based since UCrop is built on it. -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"/>
        <!-- FCM default channel — used if a push arrives before the
             Flutter side has called createNotificationChannel(). Must
             match the channel id created in PushService.initialize. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="advent_connect_zw_default" />
        <!-- Monochrome notification icon for the status bar. Falls back
             to the launcher icon if missing. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />
        <!-- Ads are served by Appodeal (18 Aug 2026), which needs NO
             manifest entry: the App Key is passed to Appodeal.initialize()
             from lib/services/ads/ad_config.dart and there are no ad-unit
             IDs to declare anywhere.

             The AdMob `com.google.android.gms.ads.APPLICATION_ID` meta-data
             that used to sit here is gone with the AdMob adapter. It is not
             optional trivia: play-services-ads CRASHES the app on launch if
             it is on the classpath without this tag. So if an AdMob adapter
             is ever added back to app/build.gradle.kts, this must come back
             in the same change:

             <meta-data
                 android:name="com.google.android.gms.ads.APPLICATION_ID"
                 android:value="ca-app-pub-2916679989954369~1736721670" />

             The AdMob account is disapproved and under appeal, so that
             should not happen soon. -->
        <!-- just_audio_background: the media-session service + media-button
             receiver that power background playback and the lock-screen /
             notification controls for the Library Music player. -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService"/>
            </intent-filter>
        </service>
        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON"/>
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Android 11+ package visibility: without these, url_launcher's
             canLaunchUrl() returns false for these schemes even when a
             handler app exists. Needed for Maps directions (https),
             phone dialer (tel), email (mailto), and SMS. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="mailto"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="smsto"/>
        </intent>
    </queries>
</manifest>
