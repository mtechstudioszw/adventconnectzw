<?xml version="1.0" encoding="utf-8"?>
<!-- The very first frame (3 Nov 2026): the splash's own logo disc, same
     116dp size, dead centre, on the splash's background — so launch →
     splash is one continuous image instead of a blank flash. The disc is
     res/drawable-*/splash_disc.png, rendered from assets/icon/logo.png on
     the primary gradient exactly as SplashScreen draws it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item
        android:width="116dp"
        android:height="116dp"
        android:gravity="center"
        android:drawable="@drawable/splash_disc" />
</layer-list>
