<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark-mode native launch window. Matches AppPalette.dark.scaffoldBg
         (0xFF0B1124), the colour splash_screen.dart paints, so the handover
         from the OS window to Flutter's first frame is invisible.

         Only launch_background is overridden here; ic_launcher_background
         is deliberately NOT — the launcher icon keeps one brand background
         in both themes, which is how every other app on the launcher
         behaves. Android falls back to values/colors.xml for it. -->
    <color name="launch_background">#0B1124</color>
</resources>
