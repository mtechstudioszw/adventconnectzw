<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Adaptive launcher icon background. Must stay in step with
         pubspec.yaml's flutter_launcher_icons.adaptive_icon_background —
         this file is REGENERATED by `dart run flutter_launcher_icons`, so
         edit it there, not here. It sat on the old #0D1B3E for a whole
         release because the icons were never regenerated after the
         rebrand. -->
    <color name="ic_launcher_background">#022171</color>
    <!-- The native launch window: the very first frame, before Flutter has
         drawn anything. It MATCHES the Flutter splash's own background
         (AppPalette.light.scaffoldBg) on purpose. It used to be dark navy,
         which meant every cold start flashed navy and then snapped to light
         grey a moment later — read as the app glitching on open. The
         values-night copy does the same against the dark palette. -->
    <color name="launch_background">#F5F7FA</color>
</resources>
