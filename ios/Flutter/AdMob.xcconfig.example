// =====================================================================
//  AdMob iOS app id override
//
//  Copy this file to `ios/Flutter/AdMob.xcconfig` (gitignored) and
//  paste your real AdMob iOS app id from the AdMob console.
//  Debug.xcconfig and Release.xcconfig both `#include?` AdMob.xcconfig,
//  so any value you set here wins over the test-id fallback.
//
//  This mirrors the Android pattern in android/key.properties.example.
//  Format: ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY (note the tilde).
// =====================================================================

ADMOB_IOS_APP_ID = ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
