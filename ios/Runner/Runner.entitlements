<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<!-- Sign in with Apple — required by App Store Guideline 4.8 when
	     a social login (Google) is offered. Add the matching
	     capability in Xcode (Signing & Capabilities → + → Sign in
	     with Apple) once the paid Apple Developer account exists, and
	     flip aps-environment to "production" for the release build.
	     See docs/APPLE_SIGN_IN_SETUP.md. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
