#!/usr/bin/env node
/**
 * Send one email to the whole membership.
 *
 * Usage (from the repo root):
 *
 *   # 1. Always start here. Sends ONLY to you.
 *   node scripts/broadcast-email.js --test-to you@example.com
 *
 *   # 2. See exactly who would receive it, send nothing.
 *   node scripts/broadcast-email.js --dry-run
 *
 *   # 3. The real thing. Asks for confirmation first.
 *   node scripts/broadcast-email.js --send
 *
 * Requires two environment variables (never commit them):
 *   SUPABASE_SERVICE_ROLE_KEY   to read the member list
 *   SMTP_PASS                   the Gmail App Password for the sender below
 *
 * ## Why a local script and not an Edge Function
 *
 * Supabase Edge Functions run on a Deno runtime whose outbound SMTP support
 * is not something to discover while sending to 213 real people. This runs
 * where it can be watched, dry-run, and stopped with Ctrl-C. It is also the
 * honest shape of the task: a broadcast is a deliberate act somebody
 * performs, not an endpoint that should exist waiting to be called.
 *
 * ## Rate limiting
 *
 * Gmail allows roughly 500 messages a day and will throttle a burst. One
 * message every 1.2s with a single connection reuses the session and lands
 * ~213 emails in about four minutes.
 */

const nodemailer = require("nodemailer");
const fs = require("fs");
const path = require("path");

/**
 * Every address that has been successfully sent to, one per line.
 *
 * Written after EACH message, not at the end. The first real run of this
 * script lost its network partway through 191 recipients and there was no
 * way afterwards to tell who had received it and who had not — the only
 * options left were to mail everyone a second time or to leave some people
 * out. Neither is acceptable, and both were avoidable with one append.
 *
 * A re-run skips anyone already in here, so it resumes rather than repeats.
 * Delete the file to deliberately send again.
 */
const SENT_LOG = path.join(__dirname, ".broadcast-sent.log");

function alreadySent() {
  try {
    return new Set(
      fs
        .readFileSync(SENT_LOG, "utf8")
        .split("\n")
        .map((s) => s.trim().toLowerCase())
        .filter(Boolean),
    );
  } catch {
    return new Set();
  }
}

function recordSent(email) {
  fs.appendFileSync(SENT_LOG, email.toLowerCase() + "\n");
}

const SENDER = "adventconnectzw@gmail.com";
const SENDER_NAME = "Advent Connect ZW";
const SUPABASE_URL = "https://eqbyvasteolqyktbqbem.supabase.co";
const PLAY_URL =
  "https://play.google.com/store/apps/details?id=io.supabase.adventconnectzw.advent_connect_zw";
const LOGO_URL = `${SUPABASE_URL}/storage/v1/object/public/library/branding/logo-240.png`;

/* ---- the message ------------------------------------------------------- */

const SUBJECT = "A new Advent Connect is here — please update";

const PREHEADER =
  "Version 1.3.2 is on the Play Store. Update to keep using the app.";

const HEADING = "Advent Connect just got better";

const INTRO =
  "We've released version 1.3.2. It's on the Play Store now, and updating " +
  "takes a few seconds.";

const WHATS_NEW = [
  ["A calmer way to post", "Writing a post is quieter and easier to read, and your draft is kept safe if you get interrupted."],
  ["The music player moves", "Drag the mini player anywhere on the screen and it stays where you put it, out of the way of what you're reading."],
  ["Watch behaves itself", "Backing out of a video now ends it instead of leaving a window following you around."],
  ["Sharing that works", "Links you share and your friend QR code now open properly for people who don't have the app yet."],
];

const CLOSING =
  "Thank you for being part of this community. If something isn't working, " +
  "reply to us from Settings → Send feedback in the app — a real person reads every one.";

/* ---- template ---------------------------------------------------------- */

const BLUE = "#1565C0";
const NAVY = "#0D1B3E";
const GOLD = "#C8A951";
const BG = "#F5F7FA";
const TEXT = "#1A1A2E";
const MUTED = "#5B6472";
const BORDER = "#E4E9F0";
const FONT =
  "-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif";

const esc = (s) =>
  String(s ?? "")
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;");

function render(firstName) {
  const greeting = firstName ? `Hi ${esc(firstName)},` : "Hello,";

  const rows = WHATS_NEW.map(
    ([title, body]) => `
      <tr>
        <td style="padding:0 0 18px 0;font-family:${FONT};">
          <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
            <tr>
              <td width="8" style="background:${BLUE};border-radius:4px;font-size:0;line-height:0;">&nbsp;</td>
              <td style="padding-left:14px;">
                <div style="font-size:15px;font-weight:bold;color:${TEXT};">${esc(title)}</div>
                <div style="font-size:13.5px;color:${MUTED};line-height:1.55;padding-top:3px;">${esc(body)}</div>
              </td>
            </tr>
          </table>
        </td>
      </tr>`,
  ).join("");

  return `<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="x-apple-disable-message-reformatting" />
<title>${esc(SUBJECT)}</title>
</head>
<body style="margin:0;padding:0;background:${BG};">
<div style="display:none;font-size:1px;color:${BG};line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;">${esc(PREHEADER)}</div>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:${BG};">
<tr><td align="center" style="padding:28px 12px;">
  <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px;background:#ffffff;border-radius:16px;overflow:hidden;border:1px solid ${BORDER};">

    <tr>
      <td style="background:${NAVY};padding:24px 28px;">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0">
          <tr>
            <td style="width:48px;vertical-align:middle;">
              <img src="${LOGO_URL}" width="48" height="48" alt="Advent Connect ZW"
                   style="display:block;width:48px;height:48px;border:0;outline:none;text-decoration:none;border-radius:12px;" />
            </td>
            <td style="padding-left:14px;font-family:${FONT};">
              <div style="font-size:17px;font-weight:bold;color:#ffffff;line-height:1.3;">Advent Connect ZW</div>
              <div style="font-size:11px;color:${GOLD};letter-spacing:1.4px;text-transform:uppercase;padding-top:2px;">Version 1.3.2</div>
            </td>
          </tr>
        </table>
      </td>
    </tr>
    <tr><td style="height:3px;background:${GOLD};font-size:0;line-height:0;">&nbsp;</td></tr>

    <tr>
      <td style="padding:32px 28px 0 28px;font-family:${FONT};">
        <p style="margin:0 0 14px 0;font-size:15px;color:${TEXT};">${greeting}</p>
        <h1 style="margin:0 0 10px 0;font-size:23px;line-height:1.3;font-weight:bold;color:${TEXT};">${esc(HEADING)}</h1>
        <p style="margin:0 0 24px 0;font-size:15px;line-height:1.6;color:${MUTED};">${esc(INTRO)}</p>
      </td>
    </tr>

    <tr>
      <td style="padding:0 28px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">${rows}</table>
      </td>
    </tr>

    <tr>
      <td align="center" style="padding:8px 28px 6px 28px;">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0">
          <tr>
            <td style="background:${BLUE};border-radius:12px;">
              <a href="${PLAY_URL}"
                 style="display:inline-block;padding:14px 34px;font-family:${FONT};font-size:15px;font-weight:bold;color:#ffffff;text-decoration:none;">
                Update on Google Play
              </a>
            </td>
          </tr>
        </table>
      </td>
    </tr>

    <tr>
      <td style="padding:20px 28px 0 28px;font-family:${FONT};">
        <p style="margin:0 0 20px 0;font-size:13.5px;line-height:1.6;color:${MUTED};">${esc(CLOSING)}</p>
      </td>
    </tr>

    <tr>
      <td style="background:${BG};padding:20px 28px;font-family:${FONT};border-top:1px solid ${BORDER};">
        <div style="font-size:12px;line-height:1.6;color:${MUTED};">
          Advent Connect ZW &mdash; a home for Seventh-day Adventists in Zimbabwe.
        </div>
        <div style="font-size:11px;line-height:1.6;color:#8A93A2;padding-top:6px;">
          You are receiving this because you have an Advent Connect account.
        </div>
      </td>
    </tr>

  </table>
</td></tr>
</table>
</body>
</html>`;
}

/** Plain-text alternative. A message with no text part scores as spam. */
function renderText(firstName) {
  const greeting = firstName ? `Hi ${firstName},` : "Hello,";
  return [
    greeting,
    "",
    HEADING,
    INTRO,
    "",
    ...WHATS_NEW.map(([t, b]) => `* ${t} — ${b}`),
    "",
    `Update here: ${PLAY_URL}`,
    "",
    CLOSING,
    "",
    "Advent Connect ZW",
  ].join("\n");
}

/* ---- recipients -------------------------------------------------------- */

async function fetchRecipients(serviceKey) {
  // auth.users is not exposed over PostgREST, so this uses the Admin API.
  // Paged, because it caps at 1000 per page and silently truncates.
  const out = [];
  for (let page = 1; page <= 20; page++) {
    const res = await fetch(
      `${SUPABASE_URL}/auth/v1/admin/users?page=${page}&per_page=200`,
      { headers: { apikey: serviceKey, Authorization: `Bearer ${serviceKey}` } },
    );
    if (!res.ok) throw new Error(`admin/users ${res.status}: ${await res.text()}`);
    const body = await res.json();
    const users = body.users ?? [];
    if (!users.length) break;
    out.push(...users);
    if (users.length < 200) break;
  }

  // Unconfirmed addresses are usually typos — mailing them earns bounces,
  // and bounces are what get a Gmail sender throttled.
  return out
    .filter((u) => u.email && u.email_confirmed_at)
    .map((u) => ({
      email: u.email,
      firstName: String(
        u.user_metadata?.full_name ?? u.user_metadata?.name ?? "",
      )
        .trim()
        .split(/\s+/)[0],
    }));
}

/* ---- main -------------------------------------------------------------- */

const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

async function main() {
  const args = process.argv.slice(2);
  const testTo = args.includes("--test-to")
    ? args[args.indexOf("--test-to") + 1]
    : null;
  const dryRun = args.includes("--dry-run");
  const send = args.includes("--send");

  if (!testTo && !dryRun && !send) {
    console.error(
      "Refusing to guess. Pass --test-to <email>, --dry-run, or --send.",
    );
    process.exit(1);
  }

  const smtpPass = process.env.SMTP_PASS;
  if (!smtpPass && !dryRun) {
    console.error("SMTP_PASS is not set (the Gmail App Password).");
    process.exit(1);
  }

  let recipients;
  if (testTo) {
    recipients = [{ email: testTo, firstName: "" }];
  } else {
    const key = process.env.SUPABASE_SERVICE_ROLE_KEY;
    if (!key) {
      console.error("SUPABASE_SERVICE_ROLE_KEY is not set.");
      process.exit(1);
    }
    recipients = await fetchRecipients(key);
  }

  console.log(`Subject   : ${SUBJECT}`);
  console.log(`Recipients: ${recipients.length}`);

  if (dryRun) {
    console.log("\n--dry-run: nothing sent. First 10 recipients:");
    for (const r of recipients.slice(0, 10)) {
      console.log(`  ${r.email}${r.firstName ? `  (${r.firstName})` : ""}`);
    }
    process.exit(0);
  }

  const transporter = nodemailer.createTransport({
    host: "smtp.gmail.com",
    port: 465,
    secure: true,
    auth: { user: SENDER, pass: smtpPass },
    pool: true,
    maxConnections: 1,
    maxMessages: Infinity,
  });

  await transporter.verify();
  console.log("SMTP connection OK.\n");

  let sent = 0;
  const failed = [];

  for (const r of recipients) {
    try {
      await transporter.sendMail({
        from: `"${SENDER_NAME}" <${SENDER}>`,
        to: r.email,
        subject: SUBJECT,
        text: renderText(r.firstName),
        html: render(r.firstName),
      });
      sent++;
      process.stdout.write(`\rSent ${sent}/${recipients.length}`);
    } catch (e) {
      failed.push({ email: r.email, error: e.message });
    }
    // Gmail throttles bursts. One message per 1.2s keeps it happy.
    if (recipients.length > 1) await sleep(1200);
  }

  transporter.close();
  console.log(`\n\nDone. Sent ${sent}, failed ${failed.length}.`);
  for (const f of failed.slice(0, 20)) console.log(`  FAILED ${f.email}: ${f.error}`);
}

main().catch((e) => {
  console.error("\n" + e.message);
  process.exit(1);
});
